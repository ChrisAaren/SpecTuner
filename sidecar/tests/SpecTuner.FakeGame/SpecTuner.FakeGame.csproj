<Project Sdk="Microsoft.NET.Sdk">

  <!-- A stand-in "game" exe for tests: never a real game. Copied into synthetic game folders as <Name>.exe. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>fake-game</AssemblyName>
  </PropertyGroup>

</Project>

{
  "build": { "command": "bun run build", "cwd": "packages/app", "output": "packages/app/dist" },
  "serve": { "command": "bun e2e/utils/serve.ts --host 127.0.0.1 --port {port}", "cwd": "packages/app" },
  "apps": {
    "spectuner": {
      "exe": {
        "windows": "%LOCALAPPDATA%/Programs/ai.opencode.desktop/OpenCode.exe",
        "macos": "/Applications/SpecTuner.app/Contents/MacOS/SpecTuner"
      },
      "unset": ["SPECTUNER_*", "OTEL_*", "SENTRY_*"],
      "env": {
        "SPECTUNER_DB": "{home}/.local/share/spectuner/spectuner.db",
        "SPECTUNER_CONFIG_DIR": "{home}/.config/spectuner",
        "HTTP_PROXY": "http://127.0.0.1:9",
        "HTTPS_PROXY": "http://127.0.0.1:9",
        "NO_PROXY": "localhost,127.0.0.1,::1"
      },
      "dirs": [".local/share/spectuner"],
      "files": {
        ".config/spectuner/service.json": { "port": "{port}" },
        "AppData/Local/@spectunerdesktop-updater": "a file, not a folder: the updater cannot stage a download while strobe measures"
      },
      "guard": [{ "file": "~/.local/state/spectuner/service.json", "pid": "pid", "url": "url" }],
      "protocols": ["spectuner"]
    },
    "spectuner-beta": {
      "extends": "spectuner",
      "exe": {
        "windows": "%LOCALAPPDATA%/Programs/ai.opencode.desktop.beta/OpenCode Beta.exe",
        "macos": "/Applications/SpecTuner Beta.app/Contents/MacOS/SpecTuner Beta"
      }
    }
  }
}
